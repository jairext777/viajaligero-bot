# Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_API_VERSION=v23.0
# Lista separada por comas, formato E.164 sin '+' (ej: 51987654321,51912345678)
SUPPORT_WHATSAPP_NUMBERS=
ESCALATION_TEMPLATE_NAME=escalacion_cliente
ESCALATION_TEMPLATE_LANG=es

# Meta / Messenger + Instagram (opcional: si se dejan vacíos, esos canales simplemente
# no procesan mensajes; el bot sigue funcionando normal por WhatsApp)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# CTA que el bot usa en Messenger/Instagram para dirigir al cliente a completar su compra
# por WhatsApp
PUBLIC_WHATSAPP_NUMBER=

# Anthropic
ANTHROPIC_API_KEY=
# Cambiar a claude-sonnet-5 reduce el costo ~60% para esta tarea; ver notas del plan.
ANTHROPIC_MODEL=claude-opus-5

# Base de datos
DATABASE_URL=

# App
# URL pública de este servicio (sin / al final) — se usa para armar el link de
# imágenes propias (ej. el QR de Yape) que se mandan por WhatsApp/Messenger/Instagram
PUBLIC_BASE_URL=
PORT=3000
NODE_ENV=development
INTERNAL_ADMIN_SECRET=
INBOX_USERNAME=admin
INBOX_PASSWORD=
CONTEXT_WINDOW_HOURS=12
MAX_CONTEXT_MESSAGES=20
ESCALATION_AUTO_RESOLVE_HOURS=24
LOG_LEVEL=info
